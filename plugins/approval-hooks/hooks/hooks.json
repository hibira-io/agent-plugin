{
  "description": "Risky shell commands wait for a second person's approval in Hibira Approvals",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline @hibira-io/mcp-approval-gate@^0.4.0 hook || exit 2",
            "timeout": 660,
            "statusMessage": "Hibira approval check"
          }
        ]
      }
    ]
  }
}
